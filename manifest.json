{
  "id": "./index.html",
  "name": "InspecteurBot RDC",
  "short_name": "InspecteurBot",
  "description": "Plateforme numérique de l’Inspection Générale du Travail de la République démocratique du Congo.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#041c5c",
  "theme_color": "#041c5c",
  "lang": "fr",
  "categories": [
    "business",
    "productivity",
    "education"
  ],
  "icons": [
    {
      "src": "./images/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./images/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./images/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Annuaire IGT",
      "short_name": "Annuaire",
      "description": "Rechercher un agent dans l’annuaire numérique.",
      "url": "./igt/index.html",
      "icons": [
        {
          "src": "./images/inspecteurbot-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Code du Travail",
      "short_name": "Code",
      "description": "Consulter le Code du Travail.",
      "url": "./code-travail.html",
      "icons": [
        {
          "src": "./images/inspecteurbot-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Rapport",
      "short_name": "Rapport",
      "description": "Accéder à l’élaboration des rapports.",
      "url": "./inspecteurs.html",
      "icons": [
        {
          "src": "./images/inspecteurbot-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Quiz Académie IGT",
      "short_name": "Quiz IGT",
      "description": "Accéder au Quiz Académie IGT.",
      "url": "./pages/Quiz_Academie_IGT/index.html",
      "icons": [
        {
          "src": "./images/inspecteurbot-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bloc-notes",
      "short_name": "Notes",
      "description": "Créer et retrouver vos notes locales.",
      "url": "./notes.html?new=1",
      "icons": [
        {
          "src": "./images/inspecteurbot-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./file-handler.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "text/plain": [
          ".txt",
          ".csv"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+inspecteurbot",
      "url": "./protocol-handler.html?url=%s"
    }
  ],
  "display_override": [
    "tabbed",
    "window-controls-overlay"
  ],
  "tab_strip": {
    "new_tab_button": {
      "url": "./notes.html"
    }
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "./notes.html?new=1"
  },
  "widgets": [
    {
      "name": "InspecteurBot — Accès rapide",
      "short_name": "InspecteurBot",
      "description": "Accéder à InspecteurBot ou créer une note locale.",
      "tag": "inspecteurbot-quick",
      "template": "inspecteurbot-quick",
      "ms_ac_template": "./widgets/inspecteurbot-widget-template.json",
      "data": "./widgets/inspecteurbot-widget-data.json",
      "type": "application/json",
      "auth": false,
      "multiple": false,
      "screenshots": [
        {
          "src": "./widgets/inspecteurbot-widget-preview.svg",
          "sizes": "600x400",
          "label": "Aperçu du widget InspecteurBot"
        }
      ]
    }
  ],
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [],
  "screenshots": [
    {
      "src": "./images/capture%201.png",
      "type": "image/png",
      "label": "Capture 1 — Interface InspecteurBot"
    },
    {
      "src": "./images/capture%202.png",
      "type": "image/png",
      "label": "Capture 2 — Interface InspecteurBot"
    }
  ]
}
